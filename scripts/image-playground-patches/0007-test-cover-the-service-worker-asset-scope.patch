From 96019968b30bd457c262dfd184ebb8e0ba532e48 Mon Sep 17 00:00:00 2001
From: pg <pg@local>
Date: Wed, 7 Oct 2026 16:53:35 +0800
Subject: [PATCH 7/7] test: cover the service worker asset scope

---
 src/lib/serviceWorker.test.js | 50 +++++++++++++++++++++++++++++++++++
 1 file changed, 50 insertions(+)
 create mode 100644 src/lib/serviceWorker.test.js

diff --git a/src/lib/serviceWorker.test.js b/src/lib/serviceWorker.test.js
new file mode 100644
index 0000000..6c18929
--- /dev/null
+++ b/src/lib/serviceWorker.test.js
@@ -0,0 +1,50 @@
+import { readFileSync } from 'node:fs'
+import vm from 'node:vm'
+
+import { describe, expect, it, vi } from 'vitest'
+
+describe('image playground service worker', () => {
+  it('does not intercept authenticated API requests outside its asset scope', () => {
+    const listeners = new Map()
+    const caches = {
+      delete: vi.fn(),
+      keys: vi.fn(),
+      match: vi.fn(),
+      open: vi.fn(),
+    }
+    const serviceWorker = {
+      addEventListener: vi.fn((type, listener) => {
+        listeners.set(type, listener)
+      }),
+      clients: { claim: vi.fn() },
+      location: { origin: 'https://new-api.example.com' },
+      registration: {
+        scope: 'https://new-api.example.com/image-playground/',
+      },
+      skipWaiting: vi.fn(),
+    }
+    const source = readFileSync(
+      new URL('../../public/sw.js', import.meta.url),
+      'utf8',
+    )
+    vm.runInNewContext(source, {
+      URL,
+      caches,
+      fetch: vi.fn(),
+      self: serviceWorker,
+    })
+    const respondWith = vi.fn()
+
+    listeners.get('fetch')?.({
+      request: {
+        method: 'GET',
+        mode: 'cors',
+        url: 'https://new-api.example.com/api/playground/image/tokens',
+      },
+      respondWith,
+    })
+
+    expect(respondWith).not.toHaveBeenCalled()
+    expect(caches.match).not.toHaveBeenCalled()
+  })
+})
