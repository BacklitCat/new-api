+// @vitest-environment jsdom
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+describe('New API hosted setup', () => {
+  beforeEach(() => {
+    vi.resetModules()
+    vi.stubEnv('VITE_NEW_API_HOSTED', 'true')
+    window.localStorage.clear()
+  })
+
+  afterEach(() => {
+    vi.unstubAllEnvs()
+  })
+
+  it('uses the account default when no API token has been selected', async () => {
+    const hosted = await import('./newApiHosted')
+
+    expect(hosted.withNewApiHostedToken({ model: 'gpt-image-2' })).toEqual({
+      model: 'gpt-image-2',
+    })
+  })
+
+  it('accepts the hosted gallery profile without an API key', async () => {
+    const profiles = await import('./apiProfiles')
+    const galleryProfile = profiles.createDefaultOpenAIProfile()
+
+    expect(galleryProfile.apiKey).toBe('')
+    expect(profiles.validateApiProfile(galleryProfile)).toBeNull()
+  })
+
+  it('provides a valid Responses profile for Agent mode automatically', async () => {
+    const profiles = await import('./apiProfiles')
+    const galleryProfile = profiles.createDefaultOpenAIProfile()
+    const settings = profiles.normalizeSettings({
+      ...profiles.DEFAULT_SETTINGS,
+      profiles: [galleryProfile],
+      activeProfileId: galleryProfile.id,
+      agentApiConfigMode: 'off',
+      agentTextProfileId: null,
+    })
+
+    expect(profiles.getActiveApiProfile(settings).apiMode).toBe('images')
+    expect(settings.agentApiConfigMode).toBe('native')
+
+    const agentProfile = profiles.getAgentTextApiProfile(settings)
+    expect(agentProfile).toMatchObject({
+      provider: 'openai',
+      apiMode: 'responses',
+      model: profiles.DEFAULT_RESPONSES_MODEL,
+    })
+    expect(agentProfile && profiles.validateApiProfile(agentProfile)).toBeNull()
+  })
+})
