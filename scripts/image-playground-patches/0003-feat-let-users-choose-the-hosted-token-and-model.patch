diff --git a/src/components/NewApiHostedModelField.tsx b/src/components/NewApiHostedModelField.tsx
new file mode 100644
index 0000000..07a4ad4
--- /dev/null
+++ b/src/components/NewApiHostedModelField.tsx
@@ -0,0 +1,51 @@
+import { useEffect, useId, useState } from 'react'
+
+import { useNewApiHostedModels } from '../hooks/useNewApiHostedModels'
+import { NEW_API_HOSTED } from '../lib/newApiHosted'
+
+interface NewApiHostedModelFieldProps {
+  label: string
+  value: string
+  placeholder: string
+  hint: string
+  onCommit: (value: string) => void
+}
+
+export default function NewApiHostedModelField(props: NewApiHostedModelFieldProps) {
+  const listId = useId()
+  const [text, setText] = useState(props.value)
+  // 当前令牌可用的模型作为候选，取不到时仍然允许手填
+  const models = useNewApiHostedModels()
+
+  useEffect(() => {
+    setText(props.value)
+  }, [props.value])
+
+  if (!NEW_API_HOSTED) return null
+
+  return (
+    <label className='block'>
+      <span className='mb-1.5 block text-sm text-gray-600 dark:text-gray-300'>{props.label}</span>
+      <input
+        value={text}
+        onChange={(event) => setText(event.target.value)}
+        onBlur={() => props.onCommit(text)}
+        onKeyDown={(event) => {
+          if (event.key === 'Enter') event.currentTarget.blur()
+        }}
+        type='text'
+        list={listId}
+        placeholder={props.placeholder}
+        className='w-full rounded-xl border border-transparent bg-black/[0.04] px-3 py-2.5 text-sm text-gray-700 outline-none transition focus:border-blue-300 dark:bg-white/[0.06] dark:text-gray-200 dark:focus:border-blue-500/50'
+      />
+      <datalist id={listId}>
+        {models.map((model) => (
+          <option key={model} value={model} />
+        ))}
+      </datalist>
+      <div data-selectable-text className='mt-1.5 text-xs text-gray-500 dark:text-gray-500'>
+        {props.hint}
+      </div>
+    </label>
+  )
+}
diff --git a/src/components/NewApiHostedTokenSelect.tsx b/src/components/NewApiHostedTokenSelect.tsx
new file mode 100644
index 0000000..f897feb
--- /dev/null
+++ b/src/components/NewApiHostedTokenSelect.tsx
@@ -0,0 +1,98 @@
+import { useCallback, useEffect, useState, useSyncExternalStore } from 'react'
+
+import {
+  fetchNewApiTokenOptions,
+  getNewApiHostedContextSnapshot,
+  getSelectedNewApiTokenId,
+  NEW_API_HOSTED,
+  setSelectedNewApiTokenId,
+  subscribeNewApiHostedContext,
+  type NewApiTokenOption,
+} from '../lib/newApiHosted'
+import Select from './Select'
+
+interface NewApiHostedTokenSelectProps {
+  /** 在设置面板中显示标签与说明，页头使用紧凑样式 */
+  labeled?: boolean
+}
+
+export default function NewApiHostedTokenSelect({ labeled = false }: NewApiHostedTokenSelectProps) {
+  const hostedContext = useSyncExternalStore(
+    subscribeNewApiHostedContext,
+    getNewApiHostedContextSnapshot,
+    getNewApiHostedContextSnapshot
+  )
+  const [tokens, setTokens] = useState<NewApiTokenOption[]>([])
+  const [error, setError] = useState('')
+  const [refreshVersion, setRefreshVersion] = useState(0)
+
+  useEffect(() => {
+    if (!NEW_API_HOSTED || !hostedContext.accessToken) return
+    let cancelled = false
+
+    void fetchNewApiTokenOptions(refreshVersion > 0)
+      .then((items) => {
+        if (cancelled) return
+        setTokens(items)
+        setError('')
+        const currentId = getSelectedNewApiTokenId()
+        if (currentId > 0 && !items.some((item) => item.id === currentId)) {
+          setSelectedNewApiTokenId(0)
+        }
+      })
+      .catch((reason: unknown) => {
+        if (!cancelled) {
+          setError(reason instanceof Error ? reason.message : '加载令牌失败')
+        }
+      })
+
+    return () => {
+      cancelled = true
+    }
+  }, [hostedContext.accessToken, hostedContext.revision, refreshVersion])
+
+  const handleOpenChange = useCallback((isOpen: boolean) => {
+    if (isOpen) setRefreshVersion((version) => version + 1)
+  }, [])
+
+  if (!NEW_API_HOSTED) return null
+
+  const enabledTokens = tokens.filter((token) => token.status === 1)
+  const options = [
+    { label: '账户默认（无需令牌）', value: '0' },
+    ...enabledTokens.map((token) => ({
+      label: token.name,
+      value: String(token.id),
+    })),
+  ]
+  const select = (
+    <Select
+      value={String(hostedContext.tokenId)}
+      onChange={(value) => setSelectedNewApiTokenId(Number.parseInt(String(value), 10) || 0)}
+      options={options}
+      onOpenChange={handleOpenChange}
+      disabled={!hostedContext.accessToken}
+      className={labeled
+        ? 'w-full rounded-xl border border-transparent bg-black/[0.04] px-3 py-2.5 text-sm text-gray-700 outline-none dark:bg-white/[0.06] dark:text-gray-200'
+        : 'w-full rounded-xl border border-gray-200/70 bg-white/60 px-2 py-1.5 text-xs text-gray-700 outline-none dark:border-white/[0.08] dark:bg-white/[0.03] dark:text-gray-200'}
+    />
+  )
+
+  if (!labeled) {
+    return (
+      <div className='hidden min-w-40 md:block' title={error || '选择 API 令牌（可选）'}>
+        {select}
+      </div>
+    )
+  }
+
+  return (
+    <label className='block'>
+      <span className='mb-1.5 block text-sm text-gray-600 dark:text-gray-300'>API 令牌</span>
+      {select}
+      <div data-selectable-text className='mt-1.5 text-xs text-gray-500 dark:text-gray-500'>
+        {error || '未选择时使用当前账户的分组与额度；选择后按该令牌的分组、额度与 IP 限制调用。'}
+      </div>
+    </label>
+  )
+}
