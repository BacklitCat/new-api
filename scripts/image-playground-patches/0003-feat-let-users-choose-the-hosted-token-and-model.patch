--- /dev/null
+++ b/src/hooks/useNewApiHostedModels.ts
@@ -0,0 +1,44 @@
+import { useEffect, useState, useSyncExternalStore } from 'react'
+
+import {
+  fetchNewApiModelOptions,
+  fetchNewApiTokenOptions,
+  getNewApiHostedContextSnapshot,
+  getSelectedNewApiTokenId,
+  NEW_API_HOSTED,
+  subscribeNewApiHostedContext,
+} from '../lib/newApiHosted'
+
+/**
+ * 托管模式下当前令牌可用的模型列表；未选择令牌时返回账户全部可用模型。
+ * 令牌变化、主站重新同步或重新挂载时刷新。
+ */
+export function useNewApiHostedModels(): string[] {
+  const hostedContext = useSyncExternalStore(
+    subscribeNewApiHostedContext,
+    getNewApiHostedContextSnapshot,
+    getNewApiHostedContextSnapshot
+  )
+  const [models, setModels] = useState<string[]>([])
+
+  useEffect(() => {
+    if (!NEW_API_HOSTED || !hostedContext.accessToken) return
+    let cancelled = false
+
+    void (async () => {
+      const selectedId = getSelectedNewApiTokenId()
+      const tokens = selectedId > 0 ? await fetchNewApiTokenOptions() : []
+      const group = tokens.find((token) => token.id === selectedId)?.group ?? ''
+      const items = await fetchNewApiModelOptions(group)
+      if (!cancelled) setModels(items)
+    })().catch(() => {
+      if (!cancelled) setModels([])
+    })
+
+    return () => {
+      cancelled = true
+    }
+  }, [hostedContext.accessToken, hostedContext.tokenId, hostedContext.revision])
+
+  return models
+}
