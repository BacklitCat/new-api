--- /dev/null
+++ b/src/components/NewApiHostedTokenSelect.tsx
@@ -0,0 +1,75 @@
+import { useEffect, useState, useSyncExternalStore } from 'react'
+
+import {
+  fetchNewApiTokenOptions,
+  getNewApiHostedContextSnapshot,
+  getSelectedNewApiTokenId,
+  NEW_API_HOSTED,
+  setSelectedNewApiTokenId,
+  subscribeNewApiHostedContext,
+  type NewApiTokenOption,
+} from '../lib/newApiHosted'
+import Select from './Select'
+
+export default function NewApiHostedTokenSelect() {
+  const accessToken = useSyncExternalStore(
+    subscribeNewApiHostedContext,
+    getNewApiHostedContextSnapshot,
+    getNewApiHostedContextSnapshot
+  )
+  const [tokens, setTokens] = useState<NewApiTokenOption[]>([])
+  const [selectedId, setSelectedId] = useState(getSelectedNewApiTokenId())
+  const [error, setError] = useState('')
+
+  useEffect(() => {
+    if (!NEW_API_HOSTED || !accessToken) return
+    let cancelled = false
+
+    void fetchNewApiTokenOptions()
+      .then((items) => {
+        if (cancelled) return
+        setTokens(items)
+        setError('')
+        if (selectedId > 0 && !items.some((item) => item.id === selectedId)) {
+          setSelectedId(0)
+          setSelectedNewApiTokenId(0)
+        }
+      })
+      .catch((reason: unknown) => {
+        if (!cancelled) {
+          setError(reason instanceof Error ? reason.message : '加载令牌失败')
+        }
+      })
+
+    return () => {
+      cancelled = true
+    }
+  }, [accessToken, selectedId])
+
+  if (!NEW_API_HOSTED) return null
+
+  const enabledTokens = tokens.filter((token) => token.status === 1)
+  const options = [
+    { label: '默认用户分组', value: '0' },
+    ...enabledTokens.map((token) => ({
+      label: token.name,
+      value: String(token.id),
+    })),
+  ]
+
+  return (
+    <div className='hidden min-w-36 md:block' title={error || '选择 New API 令牌'}>
+      <Select
+        value={String(selectedId)}
+        onChange={(value) => {
+          const nextId = Number.parseInt(value, 10) || 0
+          setSelectedId(nextId)
+          setSelectedNewApiTokenId(nextId)
+        }}
+        options={options}
+        disabled={!accessToken}
+        className='w-full rounded-xl border border-gray-200/70 bg-white/60 px-2 py-1.5 text-xs text-gray-700 outline-none dark:border-white/[0.08] dark:bg-white/[0.03] dark:text-gray-200'
+      />
+    </div>
+  )
+}
